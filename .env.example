OPENAI_API_KEY=replace_with_your_key
OPENAI_MODEL=gpt-5.6-luna
# The built-in Public Demo coding assistant. Keep this server-side only.
OPENAI_ASSISTANT_MODEL=gpt-5.6-terra
# A deliberately small, shared limit for the public portfolio demo.
OPENAI_DEMO_BUDGET_USD=1.00
OPENAI_DEMO_DATA_DIR=./data
# Hosted general web search uses a search-capable model independently of Luna.
OPENAI_SEARCH_MODEL=gpt-5.6
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=768
PORT=8787
