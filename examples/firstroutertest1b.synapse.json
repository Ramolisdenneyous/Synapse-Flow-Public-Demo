      "data": {
        "kind": "logic",
        "label": "Router",
        "description": "Routes or transforms events with deterministic rules.",
        "inputType": "event",
        "outputType": "event",
        "config": {
          "operation": "generated",
          "rules": "urgent => Review Output\n* => Archive Output",
          "template": "{{input}}",
          "routerPrompt": "You will receive a short prompt from Luna Agent,  You must roll 1d4 dice roll to rout the output from the Luna Aagent to Agent 2, Agent 3, or Agent 4.  If you roll a 2 route to agent two, if you roll a three route to agent 3 if you roll a 4 route to agent for, if you roll a 1 then reroll, to the point that you get a 2 a 2 or a 4, and then route the output from Luna agent to the rolled agent. ",
          "generatedCode": "function route(input, context, state) {\n  const agentByRoll = {\n    2: \"8a95db38-f093-46d8-9e3c-23e3279c9cc2\",\n    3: \"df9d2956-54e5-440e-8d8f-4801c42c06c0\",\n    4: \"d506ef52-766f-414c-a535-5ee34bedbc4f\"\n  };\n  const text = JSON.stringify(input);\n  let seed = state && Number.isInteger(state.seed) ? state.seed >>> 0 : 0;\n\n  for (let index = 0; index < text.length; index += 1) {\n    seed = (seed + text.charCodeAt(index)) >>> 0;\n  }\n\n  let roll = (seed % 4) + 1;\n  let rolls = 1;\n\n  if (roll === 1) {\n    seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;\n    roll = (seed % 4) + 1;\n    rolls += 1;\n  }\n\n  return {\n    targetIds: [agentByRoll[roll]],\n    state: {\n      seed: seed,\n      totalRolls: ((state && Number.isInteger(state.totalRolls)) ? state.totalRolls : 0) + rolls,\n      lastRoll: roll\n    }\n  };\n}",
          "generatedSummary": "Deterministically simulates 1d4, rerolls a 1, and routes the unchanged payload to Agent 2, 3, or 4.",
          "generatedAt": "2026-07-29T03:02:49.844Z",
          "generatedJobId": "8eb5a2ae-6964-470d-9096-73e07adbd9e8"
        },
